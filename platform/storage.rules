rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isSuperAdmin() { return signedIn() && request.auth.token.superadmin == true; }
    function kycOk() {
      return signedIn() && (
        request.auth.token.accessState == 'kyc_required'
        || request.auth.token.accessState == 'kyc_pending'
        || request.auth.token.verified == true
        || isSuperAdmin()
      );
    }
    function imageOnly() {
      return request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /kyc/{userId}/{fileName} {
      allow read: if isSuperAdmin() || (signedIn() && uid() == userId);
      allow write: if kycOk() && uid() == userId && imageOnly()
        && (fileName == 'licence-front' || fileName == 'licence-back'
            || fileName.matches('licence-front\\..+')
            || fileName.matches('licence-back\\..+'));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
