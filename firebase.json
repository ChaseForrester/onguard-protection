{
  "firestore": {
    "rules": "platform/firestore.rules",
    "indexes": "platform/firestore.indexes.json"
  },
  "functions": [
    {
      "source": "platform/functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firestore-debug.log",
        "ui-debug.log"
      ]
    }
  ],
  "storage": {
    "rules": "platform/storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "platform/functions/**",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
